{
  "name": "sonara",
  "displayName": "Sonara",
  "description": "Your assistant for working with AI agents - capture tasks and voice notes as markdown, right in your project.",
  "version": "0.1.0",
  "publisher": "artisanweblab",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/artisanweblab/sonara"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sonara.activeProject.pick",
        "title": "Switch Active Project",
        "category": "Sonara",
        "icon": "$(folder-opened)"
      },
      {
        "command": "sonara.tasks.new",
        "title": "New Task",
        "category": "Sonara",
        "icon": "$(add)"
      },
      {
        "command": "sonara.tasks.copyAgentContext",
        "title": "Copy Agent Context",
        "category": "Sonara",
        "icon": "$(link)"
      },
      {
        "command": "sonara.tasks.refresh",
        "title": "Refresh Tasks",
        "category": "Sonara",
        "icon": "$(refresh)"
      },
      {
        "command": "sonara.review.showSummary",
        "title": "Show Review Summary",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.checkStorage",
        "title": "Check Review Storage",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.refresh",
        "title": "Refresh Review",
        "category": "Sonara",
        "icon": "$(refresh)"
      },
      {
        "command": "sonara.review.openLevelDiff",
        "title": "Open Level Changes",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.openFile",
        "title": "Open File",
        "category": "Sonara",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sonara.review.openPreview",
        "title": "Open Preview",
        "category": "Sonara",
        "icon": "$(open-preview)"
      },
      {
        "command": "sonara.review.moveChange",
        "title": "Move Change",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.moveChangeUp",
        "title": "Move Change Up",
        "category": "Sonara",
        "icon": "$(arrow-up)"
      },
      {
        "command": "sonara.review.moveChangeDown",
        "title": "Move Change Down",
        "category": "Sonara",
        "icon": "$(arrow-down)"
      },
      {
        "command": "sonara.review.moveChangeToLevel",
        "title": "Move Change to Level...",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.nextNewChange",
        "title": "Next New Change",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.previousNewChange",
        "title": "Previous New Change",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.viewAsTree",
        "title": "View as Tree",
        "category": "Sonara",
        "icon": "$(list-tree)"
      },
      {
        "command": "sonara.review.viewAsList",
        "title": "View as List",
        "category": "Sonara",
        "icon": "$(list-flat)"
      },
      {
        "command": "sonara.review.expandFolder",
        "title": "Expand Folder",
        "category": "Sonara",
        "icon": "$(expand-all)"
      },
      {
        "command": "sonara.review.collapseFolder",
        "title": "Collapse Folder",
        "category": "Sonara",
        "icon": "$(collapse-all)"
      },
      {
        "command": "sonara.review.moveUp",
        "title": "Move Up",
        "category": "Sonara",
        "icon": "$(arrow-up)"
      },
      {
        "command": "sonara.review.moveDown",
        "title": "Move Down",
        "category": "Sonara",
        "icon": "$(arrow-down)"
      },
      {
        "command": "sonara.review.moveToStaged",
        "title": "Move to Staged Changes",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.moveToVerified",
        "title": "Move to Verified",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.moveToRead",
        "title": "Move to Read",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.moveToQueued",
        "title": "Move to Queued",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.moveToNew",
        "title": "Move to New",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.moveAllUp",
        "title": "Move All Up",
        "category": "Sonara",
        "icon": "$(arrow-up)"
      },
      {
        "command": "sonara.review.moveAllDown",
        "title": "Move All Down",
        "category": "Sonara",
        "icon": "$(arrow-down)"
      },
      {
        "command": "sonara.review.moveAllToStaged",
        "title": "Move All to Staged Changes",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.moveAllToVerified",
        "title": "Move All to Verified",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.moveAllToRead",
        "title": "Move All to Read",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.moveAllToQueued",
        "title": "Move All to Queued",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.moveAllToNew",
        "title": "Move All to New",
        "category": "Sonara"
      },
      {
        "command": "sonara.voice.startRecording",
        "title": "Start Recording",
        "category": "Sonara"
      },
      {
        "command": "sonara.voice.stopRecording",
        "title": "Stop Recording",
        "category": "Sonara"
      },
      {
        "command": "sonara.voice.toggleRecording",
        "title": "Start / Stop Recording",
        "category": "Sonara"
      },
      {
        "command": "sonara.voice.cancelRecording",
        "title": "Cancel Recording (discard)",
        "category": "Sonara"
      },
      {
        "command": "sonara.voice.showLog",
        "title": "Show Log",
        "category": "Sonara"
      },
      {
        "command": "sonara.voice.clearProjectLog",
        "title": "Clear Project Log",
        "category": "Sonara",
        "icon": "$(trash)"
      },
      {
        "command": "sonara.voice.changeModel",
        "title": "Change Model",
        "category": "Sonara"
      },
      {
        "command": "sonara.voice.changeLanguage",
        "title": "Change Language",
        "category": "Sonara"
      },
      {
        "command": "sonara.voice.changeDevice",
        "title": "Change Compute Device",
        "category": "Sonara"
      },
      {
        "command": "sonara.voice.changeAudioInput",
        "title": "Change Audio Input",
        "category": "Sonara"
      },
      {
        "command": "sonara.voice.restartServer",
        "title": "Restart Server",
        "category": "Sonara"
      },
      {
        "command": "sonara.voice.showServerLogs",
        "title": "Show Server Logs",
        "category": "Sonara"
      },
      {
        "command": "sonara.voice.showExtensionLogs",
        "title": "Show Extension Logs",
        "category": "Sonara"
      },
      {
        "command": "sonara.voice.downloadModel",
        "title": "Download Model",
        "category": "Sonara"
      },
      {
        "command": "sonara.voice.transcribeFile",
        "title": "Transcribe File...",
        "category": "Sonara",
        "icon": "$(new-file)"
      },
      {
        "command": "sonara.voice.toggleStreamingMode",
        "title": "Change Streaming Mode (off / adaptive / on)",
        "category": "Sonara"
      },
      {
        "command": "sonara.voice.editVocabulary",
        "title": "Edit Project Vocabulary",
        "category": "Sonara",
        "icon": "$(book)"
      },
      {
        "command": "sonara.voice.toggleShowAll.expand",
        "title": "Show All Records",
        "category": "Sonara",
        "icon": "$(eye)"
      },
      {
        "command": "sonara.voice.toggleShowAll.collapse",
        "title": "Show Recent Only",
        "category": "Sonara",
        "icon": "$(eye-closed)"
      },
      {
        "command": "sonara.voice.log.refresh",
        "title": "Refresh Voice Log",
        "category": "Sonara",
        "icon": "$(refresh)"
      },
      {
        "command": "sonara.voice.transcripts.refresh",
        "title": "Refresh Voice Transcripts",
        "category": "Sonara",
        "icon": "$(refresh)"
      },
      {
        "command": "sonara.voice.startServer",
        "title": "Start Voice Server",
        "category": "Sonara"
      },
      {
        "command": "sonara.voice.stopServer",
        "title": "Stop Voice Server",
        "category": "Sonara"
      },
      {
        "command": "sonara.voice.toggleServer",
        "title": "Toggle Voice Server (on / off)",
        "category": "Sonara"
      },
      {
        "command": "sonara.timeTracker.start",
        "title": "Start Time Tracking...",
        "category": "Sonara"
      },
      {
        "command": "sonara.timeTracker.stop",
        "title": "Stop Time Tracking",
        "category": "Sonara"
      },
      {
        "command": "sonara.timeTracker.toggle",
        "title": "Toggle Time Tracking",
        "category": "Sonara"
      },
      {
        "command": "sonara.timeTracker.openTodayFile",
        "title": "Open Today's Time Tracker File",
        "category": "Sonara"
      },
      {
        "command": "sonara.timeTracker.statusBarAction",
        "title": "Time Tracker Status Bar Action",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.revealInOS",
        "title": "Open Containing Folder",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.copyPath",
        "title": "Copy Path",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.delete",
        "title": "Delete",
        "category": "Sonara"
      },
      {
        "command": "sonara.review.showActions",
        "title": "Show Actions",
        "category": "Sonara",
        "icon": "$(ellipsis)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sonara.activeProject.pick",
          "when": "view == sonara.tasks || view == sonara.review || view == sonara.voice.log || view == sonara.voice.transcripts",
          "group": "navigation@99"
        },
        {
          "command": "sonara.tasks.new",
          "when": "view == sonara.tasks",
          "group": "navigation@1"
        },
        {
          "command": "sonara.tasks.copyAgentContext",
          "when": "view == sonara.tasks",
          "group": "navigation@2"
        },
        {
          "command": "sonara.tasks.refresh",
          "when": "view == sonara.tasks",
          "group": "1_actions@1"
        },
        {
          "command": "sonara.review.viewAsTree",
          "when": "view == sonara.review && sonara.review.viewMode == list",
          "group": "navigation@0"
        },
        {
          "command": "sonara.review.viewAsList",
          "when": "view == sonara.review && sonara.review.viewMode == tree",
          "group": "navigation@0"
        },
        {
          "command": "sonara.review.refresh",
          "when": "view == sonara.review",
          "group": "navigation@1"
        },
        {
          "command": "sonara.voice.toggleShowAll.expand",
          "when": "view == sonara.voice.log && sonara.voice.log.canToggleShowAll && !sonara.voice.log.showAll",
          "group": "navigation@1"
        },
        {
          "command": "sonara.voice.toggleShowAll.collapse",
          "when": "view == sonara.voice.log && sonara.voice.log.canToggleShowAll && sonara.voice.log.showAll",
          "group": "navigation@1"
        },
        {
          "command": "sonara.voice.editVocabulary",
          "when": "view == sonara.voice.log",
          "group": "1_actions@1"
        },
        {
          "command": "sonara.voice.clearProjectLog",
          "when": "view == sonara.voice.log",
          "group": "1_actions@2"
        },
        {
          "command": "sonara.voice.log.refresh",
          "when": "view == sonara.voice.log",
          "group": "1_actions@3"
        },
        {
          "command": "sonara.voice.editVocabulary",
          "when": "view == sonara.voice.transcripts",
          "group": "1_actions@1"
        },
        {
          "command": "sonara.voice.transcribeFile",
          "when": "view == sonara.voice.transcripts",
          "group": "navigation@1"
        },
        {
          "command": "sonara.voice.transcripts.refresh",
          "when": "view == sonara.voice.transcripts",
          "group": "1_actions@2"
        }
      ],
      "editor/title": [
        {
          "command": "sonara.review.moveChangeUp",
          "when": "resourceScheme == sonara-review",
          "group": "navigation@0"
        },
        {
          "command": "sonara.review.moveChangeDown",
          "when": "resourceScheme == sonara-review",
          "group": "navigation@0"
        },
        {
          "command": "sonara.review.openFile",
          "when": "resourceScheme == sonara-review",
          "group": "navigation@1"
        },
        {
          "command": "sonara.review.openPreview",
          "when": "resourceScheme == sonara-review && resourceLangId == markdown",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sonara.review.expandFolder",
          "when": "view == sonara.review && viewItem =~ /^reviewFolder\\./",
          "group": "inline@1"
        },
        {
          "command": "sonara.review.collapseFolder",
          "when": "view == sonara.review && viewItem =~ /^reviewFolder\\./",
          "group": "inline@2"
        },
        {
          "command": "sonara.review.moveUp",
          "when": "view == sonara.review && viewItem =~ /^review(Folder|File)\\.(new|queued|read|verified)$/",
          "group": "inline@3"
        },
        {
          "command": "sonara.review.moveDown",
          "when": "view == sonara.review && viewItem =~ /^review(Folder|File)\\.(queued|read|verified|staged)$/",
          "group": "inline@4"
        },
        {
          "command": "sonara.review.moveUp",
          "when": "view == sonara.review && viewItem =~ /^review(Folder|File)\\.(new|queued|read|verified)$/",
          "group": "1_move@1"
        },
        {
          "command": "sonara.review.moveDown",
          "when": "view == sonara.review && viewItem =~ /^review(Folder|File)\\.(queued|read|verified|staged)$/",
          "group": "1_move@2"
        },
        {
          "command": "sonara.review.moveToStaged",
          "when": "view == sonara.review && viewItem =~ /^review(Folder|File)\\.(new|queued|read|verified)$/",
          "group": "2_moveTo@1"
        },
        {
          "command": "sonara.review.moveToVerified",
          "when": "view == sonara.review && viewItem =~ /^review(Folder|File)\\.(new|queued|read|staged)$/",
          "group": "2_moveTo@2"
        },
        {
          "command": "sonara.review.moveToRead",
          "when": "view == sonara.review && viewItem =~ /^review(Folder|File)\\.(new|queued|verified|staged)$/",
          "group": "2_moveTo@3"
        },
        {
          "command": "sonara.review.moveToQueued",
          "when": "view == sonara.review && viewItem =~ /^review(Folder|File)\\.(new|read|verified|staged)$/",
          "group": "2_moveTo@4"
        },
        {
          "command": "sonara.review.moveToNew",
          "when": "view == sonara.review && viewItem =~ /^review(Folder|File)\\.(queued|read|verified|staged)$/",
          "group": "2_moveTo@5"
        },
        {
          "command": "sonara.review.moveAllUp",
          "when": "view == sonara.review && viewItem =~ /^reviewLevel\\.(new|queued|read|verified)$/",
          "group": "inline@1"
        },
        {
          "command": "sonara.review.moveAllDown",
          "when": "view == sonara.review && viewItem =~ /^reviewLevel\\.(queued|read|verified|staged)$/",
          "group": "inline@2"
        },
        {
          "command": "sonara.review.moveAllUp",
          "when": "view == sonara.review && viewItem =~ /^reviewLevel\\.(new|queued|read|verified)$/",
          "group": "1_move@1"
        },
        {
          "command": "sonara.review.moveAllDown",
          "when": "view == sonara.review && viewItem =~ /^reviewLevel\\.(queued|read|verified|staged)$/",
          "group": "1_move@2"
        },
        {
          "command": "sonara.review.moveAllToStaged",
          "when": "view == sonara.review && viewItem =~ /^reviewLevel\\.(new|queued|read|verified)$/",
          "group": "2_moveTo@1"
        },
        {
          "command": "sonara.review.moveAllToVerified",
          "when": "view == sonara.review && viewItem =~ /^reviewLevel\\.(new|queued|read|staged)$/",
          "group": "2_moveTo@2"
        },
        {
          "command": "sonara.review.moveAllToRead",
          "when": "view == sonara.review && viewItem =~ /^reviewLevel\\.(new|queued|verified|staged)$/",
          "group": "2_moveTo@3"
        },
        {
          "command": "sonara.review.moveAllToQueued",
          "when": "view == sonara.review && viewItem =~ /^reviewLevel\\.(new|read|verified|staged)$/",
          "group": "2_moveTo@4"
        },
        {
          "command": "sonara.review.moveAllToNew",
          "when": "view == sonara.review && viewItem =~ /^reviewLevel\\.(queued|read|verified|staged)$/",
          "group": "2_moveTo@5"
        },
        {
          "command": "sonara.review.revealInOS",
          "when": "view == sonara.review && viewItem =~ /^review(File|Folder)\\./",
          "group": "3_reveal@1"
        },
        {
          "command": "sonara.review.copyPath",
          "when": "view == sonara.review && viewItem =~ /^review(File|Folder)\\./",
          "group": "4_copyPath@1"
        },
        {
          "command": "sonara.review.copyRelativePath",
          "when": "view == sonara.review && viewItem =~ /^review(File|Folder)\\./",
          "group": "4_copyPath@2"
        },
        {
          "command": "sonara.review.delete",
          "when": "view == sonara.review && viewItem =~ /^review(File|Folder)\\./",
          "group": "5_modification@1"
        },
        {
          "command": "sonara.review.showActions",
          "when": "view == sonara.review && viewItem =~ /^review(Level|Folder|File)\\./",
          "group": "inline@9"
        }
      ],
      "commandPalette": [
        {
          "command": "sonara.review.revealInOS",
          "when": "false"
        },
        {
          "command": "sonara.review.copyPath",
          "when": "false"
        },
        {
          "command": "sonara.review.copyRelativePath",
          "when": "false"
        },
        {
          "command": "sonara.review.delete",
          "when": "false"
        },
        {
          "command": "sonara.review.showActions",
          "when": "false"
        },
        {
          "command": "sonara.review.openLevelDiff",
          "when": "false"
        },
        {
          "command": "sonara.review.expandFolder",
          "when": "false"
        },
        {
          "command": "sonara.review.collapseFolder",
          "when": "false"
        },
        {
          "command": "sonara.review.openFile",
          "when": "false"
        },
        {
          "command": "sonara.review.moveChange",
          "when": "false"
        },
        {
          "command": "sonara.review.moveChangeUp",
          "when": "resourceScheme == sonara-review"
        },
        {
          "command": "sonara.review.moveChangeDown",
          "when": "resourceScheme == sonara-review"
        },
        {
          "command": "sonara.review.moveChangeToLevel",
          "when": "resourceScheme == sonara-review"
        },
        {
          "command": "sonara.review.moveUp",
          "when": "false"
        },
        {
          "command": "sonara.review.moveDown",
          "when": "false"
        },
        {
          "command": "sonara.review.moveToStaged",
          "when": "false"
        },
        {
          "command": "sonara.review.moveToVerified",
          "when": "false"
        },
        {
          "command": "sonara.review.moveToRead",
          "when": "false"
        },
        {
          "command": "sonara.review.moveToQueued",
          "when": "false"
        },
        {
          "command": "sonara.review.moveToNew",
          "when": "false"
        },
        {
          "command": "sonara.review.moveAllUp",
          "when": "false"
        },
        {
          "command": "sonara.review.moveAllDown",
          "when": "false"
        },
        {
          "command": "sonara.review.moveAllToStaged",
          "when": "false"
        },
        {
          "command": "sonara.review.moveAllToVerified",
          "when": "false"
        },
        {
          "command": "sonara.review.moveAllToRead",
          "when": "false"
        },
        {
          "command": "sonara.review.moveAllToQueued",
          "when": "false"
        },
        {
          "command": "sonara.review.moveAllToNew",
          "when": "false"
        },
        {
          "command": "sonara.voice.cancelRecording",
          "when": "sonara.voice.isRecording"
        },
        {
          "command": "sonara.voice.toggleShowAll.expand",
          "when": "false"
        },
        {
          "command": "sonara.voice.toggleShowAll.collapse",
          "when": "false"
        },
        {
          "command": "sonara.timeTracker.statusBarAction",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sonara.voice.toggleRecording",
        "key": "ctrl+shift+m"
      },
      {
        "command": "sonara.voice.cancelRecording",
        "key": "ctrl+alt+m",
        "when": "sonara.voice.isRecording"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sonara",
          "title": "Sonara",
          "icon": "media/icons/sonara-mark.svg"
        }
      ]
    },
    "views": {
      "sonara": [
        {
          "type": "webview",
          "id": "sonara.tasks",
          "name": "Tasks",
          "icon": "media/icons/tasks.svg",
          "order": 2
        },
        {
          "type": "tree",
          "id": "sonara.review",
          "name": "Review",
          "icon": "media/icons/review.svg",
          "order": 3
        },
        {
          "type": "webview",
          "id": "sonara.voice.log",
          "name": "Voice Log",
          "icon": "media/icons/voice-log.svg",
          "order": 4
        },
        {
          "type": "webview",
          "id": "sonara.voice.transcripts",
          "name": "Voice Transcripts",
          "icon": "media/icons/voice-transcripts.svg",
          "order": 5
        }
      ]
    },
    "configuration": {
      "title": "Sonara",
      "properties": {
        "sonara.voice.model": {
          "type": "string",
          "default": "large-v3",
          "enum": ["tiny", "base", "small", "medium", "large-v2", "large-v3"],
          "description": "Whisper model to use for transcription"
        },
        "sonara.voice.device": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "cuda:0", "cuda:1", "cpu"],
          "description": "Compute device for Whisper"
        },
        "sonara.voice.language": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "en", "uk", "de", "fr", "es", "it", "pl", "pt", "nl", "sv", "cs", "sk", "ro", "hu", "bg", "el", "zh", "ja", "ko", "hi", "be", "ru"],
          "enumDescriptions": [
            "Auto-detect",
            "English",
            "Ukrainian (Українська)",
            "German (Deutsch)",
            "French (Français)",
            "Spanish (Español)",
            "Italian (Italiano)",
            "Polish (Polski)",
            "Portuguese (Português)",
            "Dutch (Nederlands)",
            "Swedish (Svenska)",
            "Czech (Čeština)",
            "Slovak (Slovenčina)",
            "Romanian (Română)",
            "Hungarian (Magyar)",
            "Bulgarian (Български)",
            "Greek (Ελληνικά)",
            "Chinese (中文)",
            "Japanese (日本語)",
            "Korean (한국어)",
            "Hindi (हिन्दी)",
            "Belarusian (Беларуская)",
            "Russian (Русский)"
          ],
          "description": "Transcription language (auto = detect)"
        },
        "sonara.voice.computeType": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "float16", "int8_float16", "int8", "float32"],
          "description": "Compute type for faster-whisper"
        },
        "sonara.voice.vadFilter": {
          "type": "boolean",
          "default": true,
          "description": "Enable voice activity detection filter"
        },
        "sonara.voice.audioInput": {
          "type": ["string", "null"],
          "default": null,
          "description": "Audio input device for recording. Null = system default. Use 'Sonara: Change Audio Input' to pick from available devices."
        },
        "sonara.voice.stopDelayMs": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "maximum": 5000,
          "description": "Extra recording time (ms) after Stop is pressed, so the last words are not cut off"
        },
        "sonara.voice.streamingMode": {
          "type": "string",
          "default": "off",
          "enum": ["off", "on", "adaptive"],
          "enumDescriptions": [
            "Classic: record, stop, then transcribe in one shot. Best accuracy on short messages.",
            "Live: transcribe continuously while you speak. Requires a CUDA GPU; on CPU it will overload the machine.",
            "Adaptive: stay in classic mode for short messages, switch to live mode automatically once recording exceeds the threshold. Requires a CUDA GPU for the live phase."
          ],
          "description": "Streaming transcription mode. 'adaptive' runs short recordings in classic mode (more accurate) and only engages live transcription on long ones (faster final result on long context)."
        },
        "sonara.voice.adaptiveStreamingThresholdSec": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 300,
          "description": "In adaptive streaming mode, recording switches to live transcription once it exceeds this many seconds."
        },
        "sonara.voice.streamingIntervalSec": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 10,
          "description": "How often (seconds) the streaming transcriber emits a partial result"
        },
        "sonara.voice.beamSize": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 10,
          "description": "Beam size for Whisper decoding"
        },
        "sonara.voice.log.autoOpenPanel": {
          "type": "boolean",
          "default": false,
          "description": "Auto-open Voice Log panel on VS Code start"
        },
        "sonara.voice.log.showNotificationOnTranscribe": {
          "type": "boolean",
          "default": true,
          "description": "Show toast notification after transcription"
        },
        "sonara.voice.idleShutdownMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 240,
          "description": "Minutes of inactivity before the voice server shuts down to free memory. 0 = never shut down. Applies on the next server start."
        },
        "sonara.timeTracker.tickIntervalSec": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 60,
          "description": "How often (seconds) the time tracker adds time to the current slot while a timer is active."
        },
        "sonara.timeTracker.flushIntervalSec": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 600,
          "description": "How often (seconds) time tracker writes pending ticks to disk."
        },
        "sonara.review.viewMode": {
          "type": "string",
          "default": "tree",
          "enum": ["tree", "list"],
          "enumDescriptions": ["Group files by folder", "Show a flat list of files"],
          "description": "How the Review panel lays out files."
        },
        "sonara.review.compactFolders": {
          "type": "boolean",
          "default": true,
          "description": "Render a chain of folders with a single child as one row in the Review panel."
        },
        "sonara.review.debugLog": {
          "type": "boolean",
          "default": false,
          "description": "Write per-file and per-git-process details of Review scans and moves to the Sonara Review output. Summaries, refusals and errors are always written."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "ws": "^8.18.0"
  }
}
